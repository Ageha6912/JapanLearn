    {"id": "s01", "scene": "日常聊天", "ja": "ちょっと待ってください。", "zh": "请稍等一下。", "breakdown": [{"t": "ちょっと", "zh": "一点 / 稍微"}, {"t": "待って", "zh": "等待（て形）"}, {"t": "ください", "zh": "请……"}]},
